# ─── QUICKBOOKS INTEGRATION — PRODUCTION DEPLOYMENT CHECKLIST ─────────────────
#
# Before deploying to production, ensure the following environment variables
# are set on the correct platform:
#
# ┌──────────────────────────────────────────────────────────────────────────┐
# │  BACKEND (ledgera-backend) — already set in .env                        │
# └──────────────────────────────────────────────────────────────────────────┘
#
#   QUICKBOOKS_CLIENT_ID=ABcmbN4Qme1Q0A9nWvnhksDiTtu4KWrTYa6PMzFoKb6IgjDDvw
#   QUICKBOOKS_CLIENT_SECRET=5EMqnkCAa1m6kdHsAug23On0ZEgP80jJbqC0IVKx
#   QUICKBOOKS_REDIRECT_URI=https://ledgerahq.com/oauth/quickbooks/callback
#   APP_URL=https://ledgerahq.com
#   JWT_SECRET=<64-char-hex>
#   TOKEN_ENCRYPTION_KEY=<64-char-hex>
#
# ┌──────────────────────────────────────────────────────────────────────────┐
# │  FRONTEND (nextjs-boilerplate) — set in Vercel Project Settings         │
# └──────────────────────────────────────────────────────────────────────────┘
#
#   JWT_SECRET — must match the backend's JWT_SECRET exactly
#   LEDGERA_BACKEND_URL=https://api.ledgerahq.com
#   NEXT_PUBLIC_BACKEND_URL=https://api.ledgerahq.com
#
# ┌──────────────────────────────────────────────────────────────────────────┐
# │  INTUIT DEVELOPER PORTAL                                                │
# └──────────────────────────────────────────────────────────────────────────┘
#
#   Redirect URI must be exactly:
#     https://ledgerahq.com/oauth/quickbooks/callback
#
#   Supported OAuth scopes:
#     com.intuit.quickbooks.accounting
#
# ──────────────────────────────────────────────────────────────────────────────

# ─── Required: Shared JWT Secret ──────────────────────────────────────────────
# Used by backendProxy.ts to sign tokens for backend-to-backend communication.
# Must match ledgera-backend's JWT_SECRET exactly.
JWT_SECRET=change_me_to_the_same_64_character_hex_as_backend

# ─── Google Analytics 4 ──────────────────────────────────────────────────────
# GA4 Measurement ID for the ledgerahq.com web data stream.
# The GoogleAnalytics component falls back to the stream ID if this is unset.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-00N56623LQ

# ─── Backend URL ──────────────────────────────────────────────────────────────
# The Express backend that this Next.js app proxies API requests to.
# Production: https://api.ledgerahq.com
LEDGERA_BACKEND_URL=https://ledgera-backend-production.up.railway.app
NEXT_PUBLIC_BACKEND_URL=https://ledgera-backend-production.up.railway.app

# ─── Cron Job Authentication ──────────────────────────────────────────────────
# Used by /api/cron to authenticate Vercel cron job invocations.
CRON_SECRET=change_me_to_a_random_string

# ─── Supabase (optional) ──────────────────────────────────────────────────────
# Only needed if you want Supabase-based auth in production.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# ─── Vercel (optional - auto-set by Vercel) ──────────────────────────────────
# VERCEL_URL=your-project.vercel.app
# NEXT_PUBLIC_SITE_URL=https://ledgerahq.com

# ─── Webhook Secrets (optional, recommended for production) ──────────────────
# Stripe webhook signing secret (starts with "whsec_")
# STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
# Twilio Auth Token (for webhook signature validation)
# TWILIO_AUTH_TOKEN=your_twilio_auth_token

# ─── Sentry (optional) ───────────────────────────────────────────────────────
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.us.sentry.io/xxx
# SENTRY_AUTH_TOKEN=your_sentry_auth_token
